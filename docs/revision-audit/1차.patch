+using System.Collections.Generic;
+using System.IO;
+using UnityEditor;
+using UnityEngine;
+
+/// <summary>빌더 - 텍스처 / 머티리얼 / Edible 프리팹 / FX / 설정 데이터 / 레벨 30개 생성.</summary>
+public static partial class HoleItBuilder
+{
+    // ───────────────────────── 텍스처 (UI 원, 링, 파티클 소프트) ─────────────────────────
+
+    private static Sprite whiteSprite;
+
+    private static void CreateTextures(out Sprite circle, out Sprite ring, out Texture2D soft)
+    {
+        whiteSprite = MakeSprite("Square", 4, d => 1f, true);
+        circle = MakeSprite("Circle", 128, d => Mathf.Clamp01((1f - d) * 24f), true);
+        ring = MakeSprite("Ring", 128, d => Mathf.Clamp01((d - 0.86f) * 40f) * Mathf.Clamp01((1f - d) * 40f), true);
+        // Nine-sliced, anti-aliased UI plates generated by the builder (no external art assets required).
+        roundedSprite = MakeRoundedGradientSprite("RoundedUI", 128, Color.white, Color.white);
+        playGradientSprite = MakeRoundedGradientSprite("PlayGradientUI", 128,
+            new Color(0.42f, 1.00f, 0.56f, 1f), new Color(0.04f, 0.70f, 0.56f, 1f));
+        purpleGradientSprite = MakeRoundedGradientSprite("PurpleGradientUI", 128,
+            new Color(0.55f, 0.37f, 1.00f, 1f), new Color(0.28f, 0.13f, 0.68f, 1f));
+        goldGradientSprite = MakeRoundedGradientSprite("GoldGradientUI", 128,
+            new Color(1.00f, 0.91f, 0.38f, 1f), new Color(1.00f, 0.55f, 0.12f, 1f));
+        coralGradientSprite = MakeRoundedGradientSprite("CoralGradientUI", 128,
+            new Color(1.00f, 0.50f, 0.60f, 1f), new Color(0.95f, 0.20f, 0.45f, 1f));
+        MakeSprite("Soft", 64, d => Mathf.Pow(Mathf.Clamp01(1f - d), 1.6f), false);
+        soft = AssetDatabase.LoadAssetAtPath<Texture2D>(TexDir + "/Soft.png");
+    }
+
+    /// <summary>d = 중심 0 ~ 가장자리 1 의 거리. alpha 함수로 흰색 PNG를 만든다.</summary>
+    private static Sprite MakeSprite(string name, int size, System.Func<float, float> alphaByDist, bool sprite)
+    {
+        string path = TexDir + "/" + name + ".png";
+        Texture2D t = new Texture2D(size, size, TextureFormat.RGBA32, false);
+        Color[] px = new Color[size * size];
+        for (int y = 0; y < size; y++)
+        {
+            for (int x = 0; x < size; x++)
+            {
+                float dx = (x + 0.5f) / size - 0.5f;
+                float dy = (y + 0.5f) / size - 0.5f;
+                float d = Mathf.Sqrt(dx * dx + dy * dy) * 2f;
+                px[y * size + x] = new Color(1f, 1f, 1f, Mathf.Clamp01(alphaByDist(d)));
+            }
+        }
+        t.SetPixels(px);
+        t.Apply();
+        File.WriteAllBytes(Path.Combine(Directory.GetCurrentDirectory(), path), t.EncodeToPNG());
+        Object.DestroyImmediate(t);
+        AssetDatabase.ImportAsset(path, ImportAssetOptions.ForceUpdate);
+
+        TextureImporter imp = AssetImporter.GetAtPath(path) as TextureImporter;
+        if (imp != null)
+        {
+            imp.textureType = sprite ? TextureImporterType.Sprite : TextureImporterType.Default;
+            imp.alphaIsTransparency = true;
+            imp.mipmapEnabled = false;
+            imp.SaveAndReimport();
+        }
+        return AssetDatabase.LoadAssetAtPath<Sprite>(path);
+    }
+
+    /// <summary>Rounded rectangle texture with a vertical colour gradient and a nine-slice border.</summary>
+    private static Sprite MakeRoundedGradientSprite(string name, int size, Color top, Color bottom)
+    {
+        string path = TexDir + "/" + name + ".png";
+        Texture2D t = new Texture2D(size, size, TextureFormat.RGBA32, false);
+        Color[] px = new Color[size * size];
+        const float cornerRadius = 0.19f;
+        for (int y = 0; y < size; y++)
+        {
+            float ny = (y + 0.5f) / size;
+            Color gradient = Color.Lerp(bottom, top, ny);
+            for (int x = 0; x < size; x++)
+            {
+                float nx = (x + 0.5f) / size;
+                float qx = Mathf.Abs(nx - 0.5f) - (0.5f - cornerRadius);
+                float qy = Mathf.Abs(ny - 0.5f) - (0.5f - cornerRadius);
+                float ox = Mathf.Max(qx, 0f);
+                float oy = Mathf.Max(qy, 0f);
+                float sd = Mathf.Sqrt(ox * ox + oy * oy) + Mathf.Min(Mathf.Max(qx, qy), 0f) - cornerRadius;
+                float alpha = Mathf.Clamp01(0.5f - sd * size);
+                px[y * size + x] = new Color(gradient.r, gradient.g, gradient.b, alpha * gradient.a);
+            }
+        }
+        t.SetPixels(px);
+        t.Apply();
+        File.WriteAllBytes(Path.Combine(Directory.GetCurrentDirectory(), path), t.EncodeToPNG());
+        Object.DestroyImmediate(t);
+        AssetDatabase.ImportAsset(path, ImportAssetOptions.ForceUpdate);
+        TextureImporter imp = AssetImporter.GetAtPath(path) as TextureImporter;
+        if (imp != null)
+        {
+            imp.textureType = TextureImporterType.Sprite;
+            imp.spriteImportMode = SpriteImportMode.Single;
+            imp.alphaIsTransparency = true;
+            imp.mipmapEnabled = false;
+            imp.textureCompression = TextureImporterCompression.Uncompressed;
+            imp.spritePixelsPerUnit = 100f;
+            imp.spriteBorder = new Vector4(24f, 24f, 24f, 24f);
+            // Unity 6 exposes spriteMeshType through TextureImporterSettings,
+            // not directly on TextureImporter.
+            TextureImporterSettings spriteSettings = new TextureImporterSettings();
+            imp.ReadTextureSettings(spriteSettings);
+            spriteSettings.spriteMeshType = SpriteMeshType.FullRect;
+            imp.SetTextureSettings(spriteSettings);
+            imp.SaveAndReimport();
+        }
+        return AssetDatabase.LoadAssetAtPath<Sprite>(path);
+    }
+
+    // ───────────────────────── 머티리얼 ─────────────────────────
+
+    private static Material MakeMat(string key, string shaderName, Color color)
+    {
+        Shader sh = Shader.Find(shaderName);
+        if (sh == null) throw new System.InvalidOperationException("Required shader missing: "+shaderName);
+        Material m = new Material(sh);
+        if (m.HasProperty("_Color")) m.SetColor("_Color", color);
+        if (m.HasProperty("_Glossiness")) m.SetFloat("_Glossiness", 0.28f);
+        if (m.HasProperty("_Metallic")) m.SetFloat("_Metallic", 0.02f);
+        return SaveAsset(m, MatDir + "/" + key + ".mat");
+    }
+
+    private static Dictionary<string, Material> CreateMaterials(Texture2D soft)
+    {
+        Dictionary<string, Material> d = new Dictionary<string, Material>();
+        d["Ground"] = MakeMat("Ground", "HoleIt/GroundStencil", Color.white);
+        // Saturated violet checkerboard inspired by colourful casual puzzle arenas.
+        if (d["Ground"].HasProperty("_ColorA")) d["Ground"].SetColor("_ColorA", new Color(0.43f, 0.15f, 0.72f, 1f));
+        if (d["Ground"].HasProperty("_ColorB")) d["Ground"].SetColor("_ColorB", new Color(0.38f, 0.12f, 0.66f, 1f));
+        if (d["Ground"].HasProperty("_Tiles")) d["Ground"].SetFloat("_Tiles", 30f);
+        d["Mask"] = MakeMat("HoleMask", "HoleIt/HoleMask", Color.white);
+        d["Pit"] = MakeMat("HolePit", "HoleIt/HolePit", Color.white);
+        d["Rim"] = MakeMat("HoleRim", "HoleIt/HoleRim", Color.white);
+        d["Rim"].SetColor("_Color", new Color(0.88f, 0.97f, 1f, 0.96f));
+        EditorUtility.SetDirty(d["Ground"]);
+        d["Dark"] = MakeMat("Dark", "Mobile/Diffuse", new Color(0.18f, 0.18f, 0.22f));
+        Material p = MakeMat("Particle", "Mobile/Particles/Additive", Color.white);
+        if (soft != null) p.SetTexture("_MainTex", soft);
+        d["Particle"] = p;
+        EditorUtility.SetDirty(d["Rim"]);
+        EditorUtility.SetDirty(p);
+        return d;
+    }
+
+    private static Material ColorMat(Dictionary<string, Material> mats, string key, Color c)
+    {
+        string k = "Mat_" + key;
+        if (!mats.ContainsKey(k)) mats[k] = MakeMat(k, Shader.Find("Standard") != null ? "Standard" : "Mobile/Diffuse", c);
+        return mats[k];
+    }
+
+    // ───────────────────────── Edible 종류 정의 ─────────────────────────
+
+    private class Spec
+    {
+        public string key, display, shape;
+        public ObjectType type;
+        public int tier, score;
+        public float size, growth;
+        public Color color;
+        public bool swallowable = true;
+    }
+
+    private static Spec S(string key, string display, ObjectType type, int tier, string shape, float size, Color color, int score, float growth, bool swallowable = true)
+    {
+        return new Spec { key = key, display = display, type = type, tier = tier, shape = shape, size = size, color = color, score = score, growth = growth, swallowable = swallowable };
+    }
+
+    private static List<Spec> AllSpecs()
+    {
+        return new List<Spec> {
+            S("BallS", "SPORT BALL", ObjectType.Ball, 1, "Ball", 0.7f, new Color(0.95f,0.3f,0.12f), 10, 0.7f),
+            S("BoxS", "CRATE", ObjectType.Box, 1, "Box", 0.7f, new Color(0.27f,0.5f,0.92f), 10, 0.7f),
+            S("DonutS", "DONUT", ObjectType.Food, 1, "Donut", 0.78f, new Color(1.0f,0.28f,0.61f), 12, 0.8f),
+            S("WaffleS", "WAFFLE", ObjectType.Food, 1, "Waffle", 0.78f, new Color(1.0f,0.69f,0.2f), 12, 0.8f),
+            S("CookieS", "COOKIE", ObjectType.Food, 1, "Cookie", 0.68f, new Color(0.84f,0.48f,0.19f), 10, 0.7f),
+            S("CupcakeS", "CUPCAKE", ObjectType.Food, 1, "Cupcake", 0.7f, new Color(1.0f,0.42f,0.69f), 14, 0.9f),
