+    [Tooltip("가속 (units/s^2) - 빠르게")]
+    public float acceleration = 60f;
+    [Tooltip("감속 (units/s^2) - 약간 부드럽게")]
+    public float deceleration = 38f;
+    [Tooltip("크기 단계가 올라갈 때 속도 보정 곡선 (x: 반지름/초기반지름, y: 속도 배율). 감소폭을 작게 유지")]
