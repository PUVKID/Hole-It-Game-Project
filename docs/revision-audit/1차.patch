+            for (int x = 0; x < segments; x++)
+            {
+                int a = y * (segments + 1) + x; int b = a + segments + 1;
+                tri.Add(a); tri.Add(b); tri.Add(a + 1); tri.Add(a + 1); tri.Add(b); tri.Add(b + 1);
