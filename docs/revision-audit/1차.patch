+
+    [MenuItem("HoleIt/1. 프로젝트 전체 구성")]
+    public static void BuildAllMenu()
+    {
+        if (!BuildAll(true)) return;
+        string msg = "구성 완료!\nAssets/Scenes/Main.unity 를 열어 Play 하세요.";
