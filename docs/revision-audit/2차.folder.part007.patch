-    private static string SafeAssetName(string value)
-    {
-        char[] chars = value.ToCharArray();
-        for (int i = 0; i < chars.Length; i++)
-            if (!(char.IsLetterOrDigit(chars[i]) || chars[i] == '_' || chars[i] == '-')) chars[i] = '_';
-        return new string(chars);
-    }
