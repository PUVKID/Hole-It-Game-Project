+using System;
+using TMPro;
+using UnityEngine;
+using UnityEngine.UI;
+
+public partial class ReferenceGame
+{
+    GameObject attendancePanel;
+    Image[] attendanceCards;
+    TextMeshProUGUI[] attendanceCardStates;
