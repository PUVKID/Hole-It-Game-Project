+            Sprite circle=AssetDatabase.LoadAssetAtPath<Sprite>(TexDir+"/Circle.png"),ring=AssetDatabase.LoadAssetAtPath<Sprite>(TexDir+"/Ring.png");Texture2D soft;
+            CreateTextures(out circle,out ring,out soft);
